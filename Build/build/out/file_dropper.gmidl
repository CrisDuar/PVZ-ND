[gml_api]
module file_dropper;


[lib_map = { windows: [ file_dropper_x64.dll ] }]
group {
    [global] const file_dropper_mk_lbutton : real = 1;

    [global] const file_dropper_mk_rbutton : real = 2;

    [global] const file_dropper_mk_shift : real = 4;

    [global] const file_dropper_mk_control : real = 8;

    [global] const file_dropper_mk_mbutton : real = 16;

    [global] const file_dropper_mk_alt : real = 32;

    [global] const file_dropper_effect_none : real = 0;

    [global] const file_dropper_effect_copy : real = 1;

    [global] const file_dropper_effect_move : real = 2;

    [global] const file_dropper_effect_link : real = 4;

    [global, bind = gmval]
    function file_dropper_init_raw([allow_raw_ptr] arg0 : cstring, arg1 : real) : real;

    [global, bind = gmval]
    function file_dropper_get_allow_raw() : real;

    [global, bind = gmval]
    function file_dropper_set_allow_raw(arg0 : real) : real;

    [global, bind = gmval]
    function file_dropper_get_effect_raw(arg0 : real) : real;

    [global, bind = gmval]
    function file_dropper_set_effect_raw(arg0 : real) : real;

    [global, bind = gmval]
    function file_dropper_get_default_allow_raw() : real;

    [global, bind = gmval]
    function file_dropper_set_default_allow_raw(arg0 : real) : real;

    [global, bind = gmval]
    function file_dropper_get_default_effect_raw(arg0 : real) : real;

    [global, bind = gmval]
    function file_dropper_set_default_effect_raw(arg0 : real) : real;

    [global, bind = gmval]
    function RegisterCallbacks([allow_raw_ptr] arg0 : cstring, [allow_raw_ptr] arg1 : cstring, [allow_raw_ptr] arg2 : cstring, [allow_raw_ptr] arg3 : cstring) : real;

}

