if global.lang="es"{
switch(global.vsmap){
case 0: text="Día"; image_index=0; break
case 1: text="Atardecer"; image_index=1; break
case 2: text="Noche"; image_index=2; break
case 3: text="Piscina"; image_index=3; break
case 4: text="Niebla"; image_index=5; break
case 5: text="Oscuridad"; image_index=6; break
}}else{
switch(global.vsmap){
case 0: text="Day"; image_index=0; break
case 1: text="Sunset"; image_index=1; break
case 2: text="Night"; image_index=2; break
case 3: text="Pool"; image_index=3; break
case 4: text="Fog"; image_index=5; break
case 5: text="Dusk"; image_index=6; break
}}



