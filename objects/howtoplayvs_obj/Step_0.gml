switch(image_index){
case 0:
message_en="Versus Mode is a two-player game mode. The farther the player progresses in the Adventure Mode, the more plants and zombies become available."
message_es="El Duelo es un modo de juego para dos jugadores. Cuanto más avance el jugador en el Modo Aventura, más plantas y zombis estarán disponibles."
tittle_en="Introduction"
tittle_es="Introducción"
break

case 1:
message_en="The plants must shoot down three of the Target Zombies lined up on the back row of the zombies' starting line."
message_es="Las plantas deben derribar a tres Zombis objetivo alineados en la última fila de la línea de salida de los zombis."
tittle_en="How to win (Plants)"
tittle_es="Cómo ganar (Plantas)"
break

case 2:
message_en="The zombies must get into the house to eat brains"
message_es="Los zombis deben entrar a la casa para comer cerebros."
tittle_en="How to win (Zombies)"
tittle_es="Cómo ganar (Zombis)"
break

case 3:
message_en="Both sides use predetermined units."
message_es="Ambos jugadores usan unidades predeterminadas."
tittle_en="Quick play"
tittle_es="Partida rápida"
break

case 4:
message_en="Lets each side choose what plants or zombies they want."
message_es="Permite que cada equipo elija las plantas o zombis que quiera."
tittle_en="Custom play"
tittle_es="Partida personalizada"
break

case 5:
message_en="The Units are delivered through a conveyor belt and the sun won't fall. Units are preselected."
message_es="Las Unidades se entregan a través de una cinta transportadora y no caerá sol. Las Unidades están preseleccionadas."
tittle_en="Special delivery"
tittle_es="Entrega especial"
break

case 6:
message_en="Sudden Death will start after five minutes have elapsed. When it occurs, Sunflowers and Zom-Graves will become unavailable to place."
message_es="La Batalla a muerte empezará después de cinco minutos. Cuando ocurra, los girasoles y las tumbas Zom serán bloqueadas."
tittle_en="Sudden death"
tittle_es="Batalla a muerte"
break

case 7:
message_en="Play online by hosting or connecting to another PC. Host means that you can allow others to connect to you and that you have the game. Strong internet connection is needed."
message_es="Juega online hosteando o conectándote a otro PC. Ser host significa que permites a otros conectarse a tu PC y que posees el juego. Se requiere una buena conexión a internet."
tittle_en="Play online with Parsec"
tittle_es="Juega online con Parsec"
break

case 8:
message_en="Units are randomly chosen by Randomizer. Read the instructions for using it."
message_es="Las unidades son escogidas aleatoriamente por el randomizador. Lee las instrucciones para usarlo."
tittle_en="Randomizer"
tittle_es="Randomizador"
break

case 9:
message_en="By connecting one or two gamepads, players will be able to choose their team and play with their controller. To detect your controller, press any button."
message_es="Conectando uno o dos controles, los jugadores podrán elegir su equipo usando sus mandos. Presiona cualquier botón para detectar tu control."
tittle_en="Controller support"
tittle_es="Soporte de mandos"
break
}

