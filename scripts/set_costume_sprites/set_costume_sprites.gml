/// @description set_costume_sprites(Only for selectanim_obj)
/// @param Only for selectanim_obj
function set_costume_sprites() {

	if seed==menuselectplan_obj.plant{
	    switch(menuselectplan_obj.plant){
	        case menupea_obj:
	            check_costume_sprites(menupea2_spr, menupea3_spr)
	        break
        
	        case garlicdroneslot_obj:
	            check_costume_sprites(garlicdroneslot2_spr)
	        break
        
	        case menugravebuster_obj:
	            check_costume_sprites(menugravebuster2_spr)
	        break
        
	        case menunut_obj:
	            check_costume_sprites(nutslot2_spr)
	        break
        
	        case menurepea_obj:
	            check_costume_sprites(menurepea2_spr)
	        break
        
	        case jalapenoslot_obj:
	            check_costume_sprites(jalapenoslot2_spr)
	        break
        
	        case menupuff_obj:
	            check_costume_sprites(menupuff2_spr)
	        break
        
	        case menusnpea_obj:
	            check_costume_sprites(menusnpea2_spr)
	        break
        
	        case menuhealer_obj:
	            check_costume_sprites(menuhealer2_spr)
	        break
        
	        case magnetslot_obj:
	            check_costume_sprites(magnetslot2_spr)
	        break
        
	        case levicottonslot_obj:
	            check_costume_sprites(levicottonslot2_spr)
	        break
	    }
	}




}
